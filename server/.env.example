MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/cropsure
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
OFFICER_NAME=Shiwani 
OFFICER_ID=Shiwani
OFFICER_PASSWORD=Shiwani@1234

# Use gemini for Google's free-tier API, or openai for the OpenAI API
AI_PROVIDER=gemini
# Required when AI_PROVIDER=openai
AI_API_KEY=replace-with-your-ai-provider-key
# Optional: defaults to OpenAI Responses API
AI_API_URL=https://api.openai.com/v1/responses
AI_MODEL=gpt-4o-mini
# Required when AI_PROVIDER=gemini. Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-with-your-free-gemini-key
GEMINI_MODEL=gemini-3.6-flash
# Optional: try this model if the primary model is busy or out of quota
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
